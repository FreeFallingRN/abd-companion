# Sanity Configuration
# Create a free project at https://sanity.io/manage and paste your Project ID below.
# When NEXT_PUBLIC_SANITY_PROJECT_ID is set to 'demo' or left blank, the app will
# automatically operate in Offline / Demo Mode using the local novel database!

NEXT_PUBLIC_SANITY_PROJECT_ID=demo
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional write token if running automated seeding into Sanity Cloud
SANITY_API_WRITE_TOKEN=
