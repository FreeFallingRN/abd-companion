{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skill",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "element",
    "starRank",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "active",
        "passive"
      ]
    },
    "element": {
      "type": "string"
    },
    "starRank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "description": {
      "type": "string"
    }
  }
}