{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RealmOrAcademy",
  "type": "object",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "tier": {
      "type": "string"
    },
    "bastion": {
      "type": "string"
    },
    "departments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dangerTier": {
      "type": "string",
      "enum": [
        "green",
        "blue",
        "purple",
        "orange",
        "red",
        "black",
        "calamity"
      ]
    },
    "recommendedRank": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  }
}